# Supabase Dashboard → Project Settings → API / API Keys.
# Copy this file to .env.local and fill in your project's actual values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Never prefix this value with NEXT_PUBLIC_ or commit .env.local.
SUPABASE_SECRET_KEY=

# Older Supabase projects may use these aliases instead of the keys above:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
